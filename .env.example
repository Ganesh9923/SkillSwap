# ===================================================================
# SkillSwap Environment Configuration Template
# Hackathon ID: AZIS-SNTAGG | Track 2: Real-World AI Products
# Copy this file to .env and configure your values.
# ===================================================================

# Database Configuration (MySQL / Cloud Database)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="skillswap_db"
DB_USER="root"
DB_PASS=""

# Outgoing Server (Hostinger SMTP SSL)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="ssl"
SMTP_USER="support@dalavix.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM_EMAIL="support@dalavix.com"
SMTP_FROM_NAME="SkillSwap Platform"

# Payment Gateway (Razorpay Live INR)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
RAZORPAY_CURRENCY="INR"
USD_TO_INR=85.0
