{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/\\.env(.*)", "status": 404 },
    { "src": "/\\.git(.*)", "status": 404 },
    { "src": "/config/(.*)", "status": 404 },
    { "src": "/schema\\.sql", "status": 404 },
    { "src": "/logs/(.*)", "status": 404 },
    { "src": "/test_suite\\.php", "status": 404 },
    { "src": "/test_http_lifecycle\\.php", "status": 404 },
    { "src": "/verify_endpoints\\.php", "status": 404 },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/bookings(\\.php)?", "dest": "/api/bookings.php" },
    { "src": "/api/gigs(\\.php)?", "dest": "/api/gigs.php" },
    { "src": "/api/payments(\\.php)?", "dest": "/api/payments.php" },
    { "src": "/api/seed(\\.php)?", "dest": "/api/seed.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
